# --- Pflicht ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (Analyse + Skripte + Veo-Videos)
APP_TOKEN=                 # Passwort fuer die App (leer = wird beim Start zufaellig erzeugt)

# --- Video-Generierung ---
VIDEO_MODEL=veo-3.1-generate-preview
TEXT_MODEL=gemini-2.5-flash
VIDEO_RESOLUTION=4k        # 4k | 1080p | 720p  (4k wird probiert, sonst Fallback + ffmpeg-Upscale)

# --- Instagram (Graph API, Reels) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_BASE_URL=           # oeffentliche https-URL dieses Servers (Instagram muss das Video abrufen koennen)

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY   # SELF_ONLY bis deine TikTok-App auditiert ist, danach PUBLIC_TO_EVERYONE
